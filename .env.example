# ---------------------------------------------------------------------------
# NexaPay QA suite — copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# Web application root (Angular SPA). Supplied by e-mail in the assessment.
NEXAPAY_BASE_URL=http://localhost:3200

# API root. Defaults to ${NEXAPAY_BASE_URL}/api/v1 when left empty.
NEXAPAY_API_URL=

# Test accounts (demo environment, fictitious — see Annexe A of the brief).
# Kept out of source so the same suite can run against any environment.
NEXAPAY_ADMIN_EMAIL=admin@nexapay.test
NEXAPAY_ADMIN_PASSWORD=
NEXAPAY_MANAGER_EMAIL=manager@nexapay.test
NEXAPAY_MANAGER_PASSWORD=
NEXAPAY_MEMBER_EMAIL=member@nexapay.test
NEXAPAY_MEMBER_PASSWORD=

# 6-digit PIN used by transfer flows.
NEXAPAY_TEST_PIN=123456

# Non-functional thresholds asserted by the perf-budget checks (ms).
# Source: Annexe D of the brief. Override per environment.
NFR_TRANSFERS_P95_MS=500
NFR_TRANSACTIONS_P95_MS=300

# Execution mode:
#   live     -> run against NEXAPAY_BASE_URL
#   recorded -> run against the local replay server built from src/fixtures/recorded
TEST_MODE=live
